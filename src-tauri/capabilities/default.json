{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:event:default",
    "core:path:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/fine-tune" },
        { "path": "$APPDATA/fine-tune/*" },
        { "path": "$APPDATA/fine-tune/**" }
      ]
    },
    "shell:allow-open"
  ]
}
